# ClaudeCandle Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Solana RPC Connection
# =============================================================================
# Default: Solana public RPC (no API key needed, works immediately)
# For production / higher rate limits, use Helius (free key at https://helius.dev):
#   HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_RPC_URL=https://api.mainnet-beta.solana.com

# =============================================================================
# REQUIRED: Wallet Configuration
# =============================================================================
# Your wallet's private key in base58 format
# SECURITY: Never commit this file with real keys!
# Generate a new wallet: npx tsx scripts/setup.ts
WALLET_PRIVATE_KEY=your_base58_encoded_private_key_here

# =============================================================================
# OPTIONAL: Network Selection
# =============================================================================
# auto.fun is mainnet-only. This setting is for the RPC connection.
SOLANA_NETWORK=mainnet-beta

# =============================================================================
# OPTIONAL: Pinata IPFS (for token metadata with images/descriptions)
# =============================================================================
# Get a free JWT at https://app.pinata.cloud/developers/api-keys
# Without this, you can still launch tokens but must provide your own metadata URI.
# PINATA_JWT=your_pinata_jwt_here
