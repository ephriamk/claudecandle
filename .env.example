# ClaudeCandle Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Bags.fm API Key
# =============================================================================
# Get your API key from https://dev.bags.fm
BAGS_API_KEY=your_bags_fm_api_key_here

# =============================================================================
# REQUIRED: Solana RPC Connection
# =============================================================================
# Get a free API key from https://helius.dev
# For mainnet: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# For devnet: https://devnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# =============================================================================
# REQUIRED: Wallet Configuration
# =============================================================================
# Your wallet's private key in base58 format
# SECURITY: Never commit this file with real keys!
# Export from Phantom/Backpack or generate new: solana-keygen new --outfile wallet.json
WALLET_PRIVATE_KEY=your_base58_encoded_private_key_here

# =============================================================================
# OPTIONAL: Network Selection
# =============================================================================
# Options: mainnet-beta, devnet
# Note: Bags.fm is primarily mainnet-focused
SOLANA_NETWORK=mainnet-beta

# =============================================================================
# OPTIONAL: Transaction Settings
# =============================================================================
# Default slippage in basis points (500 = 5%)
DEFAULT_SLIPPAGE_BPS=500

# Default priority fee level: low, medium, high, veryHigh
DEFAULT_PRIORITY_LEVEL=high

# =============================================================================
# OPTIONAL: Creator Fee Configuration
# =============================================================================
# Creators earn 1% of all trading volume forever on Bags.fm
# Default fee share wallet (leave blank to use signing wallet)
FEE_SHARE_WALLET=

# Fee percentage in basis points (10000 = 100% to creator, default)
FEE_SHARE_BPS=10000

# =============================================================================
# OPTIONAL: Logging
# =============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info
