{
  "name": "claudecandle",
  "version": "2.0.0",
  "description": "MCP server and Claude Code skill for launching and trading Solana meme coins on auto.fun",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "launch": "npx tsx scripts/launch.ts",
    "buy": "npx tsx scripts/buy.ts",
    "sell": "npx tsx scripts/sell.ts",
    "balance": "npx tsx scripts/balance.ts",
    "info": "npx tsx scripts/info.ts",
    "setup": "npx tsx scripts/setup.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "solana",
    "meme-coin",
    "auto-fun",
    "bonding-curve",
    "launchpad",
    "claude",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "idl",
    "scripts",
    "CLAUDE.md"
  ]
